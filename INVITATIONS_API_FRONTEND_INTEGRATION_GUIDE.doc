    </tr>
    <tr>
      <td>UI Ergonomics</td>
      <td><code>src/components/dashboard/tabs/InvitationsTab.tsx</code></td>
      <td><strong>PASS</strong> &bull; Touch-friendly buttons, responsive card layout, and accessible modal.</td>
    </tr>
  </tbody>
</table>

</body>
</html>
